# Site settings: the values that are true for one installation only. Example with invented values.
#
# Copy this file to /etc/creative-suite/site.env on each machine and adapt it. The install scripts stop,
# before changing anything, when a setting they need is missing. Lines are KEY=value, no quotes.

# --- Workstation (deploy/install.sh) ---
# Address the clients use to reach the workstation. It becomes the WebRTC candidate of Moonlight Web and
# an allowed origin of the Sunshine web UI.
WORKSTATION_ADDRESS=10.0.0.30
# Other names the Sunshine web UI is opened with, comma-separated, without scheme. Optional: the address
# above and the host name of the machine are always allowed.
WORKSTATION_NAMES=workstation.example.local,creative.example.local

# --- Browser suite (deploy/web/install.sh) ---
# Each app is served at https://<app>.<WEB_DOMAIN>, the landing page at https://apps.<WEB_DOMAIN>.
WEB_DOMAIN=apps.example.com
