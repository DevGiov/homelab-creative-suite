# CADCraft (CAD 2D). Read by creative-run (creative-app@.service), the MCP bridge (mcp-server/server.py)
# and the session generator (deploy/gen-session-config.py): one file per app, no duplicated settings.
LABEL=CADCraft
CATEGORY="Grafica"
CONTROL_PORT=7982
AUTH=token-file
AUTH_STYLE=request
TOKEN_FILE=/run/user/0/cadcraft-control-7982.token
TOKEN_ARG=none
OPEN_METHOD=app.open
CLI_ACTIONS="info convert run commands sample"
APP_ARGS=
AUTOSTART=no
# The display is software-rendered (Mesa llvmpipe); one thread keeps an idle window cheap.
LP_NUM_THREADS=1
