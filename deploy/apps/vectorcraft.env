# VectorCraft (grafica vettoriale). Read by creative-run (creative-app@.service), the MCP bridge (mcp-server/server.py)
# and the session generator (deploy/gen-session-config.py): one file per app, no duplicated settings.
LABEL=VectorCraft
CATEGORY="Grafica"
CONTROL_PORT=7980
OPEN_METHOD=app.open
CLI_ACTIONS="info convert run commands"
APP_ARGS=
AUTOSTART=no
# The display is software-rendered (Mesa llvmpipe); one thread keeps an idle window cheap.
LP_NUM_THREADS=1
