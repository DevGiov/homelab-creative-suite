# FilmCraft (montaggio video). Read by creative-run (creative-app@.service), the MCP bridge (mcp-server/server.py)
# and the session generator (deploy/gen-session-config.py): one file per app, no duplicated settings.
LABEL=FilmCraft
CATEGORY="Audio e video"
CONTROL_PORT=7986
OPEN_METHOD=app.open
CLI_ACTIONS="exec run commands describe inspect import export"
APP_ARGS="--data-dir /workspace/.filmcraft"
AUTOSTART=no
# The display is software-rendered (Mesa llvmpipe); one thread keeps an idle window cheap.
LP_NUM_THREADS=1
