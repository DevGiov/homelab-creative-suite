# WordCraft (documents). Read by creative-app@.service and the MCP bridge.
CONTROL_PORT=7981
APP_ARGS=
CLI_ACTIONS="info text inspect convert render run commands parity"
# WordCraft has no app.open control method; files open through the engine command.
OPEN_METHOD=engine:file.open
# WordCraft 0.3.0 repaints continuously while its window is visible (0% when minimised), and on
# the dummy Xorg every frame goes through Mesa llvmpipe (software GL): ~380% CPU idle with the
# default thread pool, ~100% with one thread. Start it on demand (session_launch) instead of at
# boot, and keep llvmpipe to a single thread while it runs.
AUTOSTART=no
LP_NUM_THREADS=1
