# WordCraft (documenti). Read by creative-run (creative-app@.service), the MCP bridge (mcp-server/server.py)
# and the session generator (deploy/gen-session-config.py): one file per app, no duplicated settings.
LABEL=WordCraft
CATEGORY="Documenti"
CONTROL_PORT=7981
OPEN_METHOD=engine:file.open
CLI_ACTIONS="info text inspect convert render run commands parity"
APP_ARGS=
AUTOSTART=no
# The display is software-rendered (Mesa llvmpipe); one thread keeps an idle window cheap.
LP_NUM_THREADS=1
