# GridCraft (fogli di calcolo). Read by creative-run (creative-app@.service), the MCP bridge (mcp-server/server.py)
# and the session generator (deploy/gen-session-config.py): one file per app, no duplicated settings.
LABEL=GridCraft
CATEGORY="Documenti"
CONTROL_PORT=7983
AUTH=token-file
TOKEN_FILE=/run/user/0/gridcraft/control-7983.token
TOKEN_ARG=none
OPEN_METHOD=app.open
CLI_ACTIONS="info convert eval cat run commands functions"
APP_ARGS=
AUTOSTART=yes
# The display is software-rendered (Mesa llvmpipe); one thread keeps an idle window cheap.
LP_NUM_THREADS=1
