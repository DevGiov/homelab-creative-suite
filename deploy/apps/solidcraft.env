# SolidCraft (CAD 3D). Read by creative-run (creative-app@.service), the MCP bridge (mcp-server/server.py)
# and the session generator (deploy/gen-session-config.py): one file per app, no duplicated settings.
LABEL=SolidCraft
CATEGORY="Grafica"
CONTROL_PORT=7988
AUTH=token-file
AUTH_STYLE=request
TOKEN_FILE=/root/.local/share/solidcraft/control/7988.token
TOKEN_ARG=none
# Not a storytold app: its own id, and its icons live elsewhere in the tree.
APP_ID=io.tangencylabs.solidcraft
ICON_DIR=assets/icons/app/linux/exports/hicolor
OPEN_METHOD=engine:doc.open
CLI_ACTIONS="run eval inspect snapshot render commands gpu"
APP_ARGS=
AUTOSTART=no
# The display is software-rendered (Mesa llvmpipe); one thread keeps an idle window cheap.
LP_NUM_THREADS=1
