# PhotoCraft (fotoritocco raster). Read by creative-run (creative-app@.service), the MCP bridge (mcp-server/server.py)
# and the session generator (deploy/gen-session-config.py): one file per app, no duplicated settings.
LABEL=PhotoCraft
CATEGORY="Grafica"
CONTROL_PORT=7878
AUTH=token-file
TOKEN_FILE=/run/creative-suite/photocraft.token
PATH_MODE=workspace-relative
OPEN_METHOD=app.open
CLI_ACTIONS="info convert run commands"
# --safe-gpu: the virtual display has no GPU surface; without it every launch ends in a
# "Switched to CPU rendering" dialog.
APP_ARGS="--safe-gpu --automation-read-root /workspace --automation-write-root /workspace"
AUTOSTART=no
# The display is software-rendered (Mesa llvmpipe); one thread keeps an idle window cheap.
LP_NUM_THREADS=1
