# PdfCraft (PDF). Read by creative-run (creative-app@.service), the MCP bridge (mcp-server/server.py)
# and the session generator (deploy/gen-session-config.py): one file per app, no duplicated settings.
LABEL=PdfCraft
CATEGORY="Documenti"
AUTH=control-file
CONTROL_FILE=/run/creative-suite/pdfcraft.control
EXEC_METHOD=ui.command
OPEN_METHOD=ui.open
CLI_ACTIONS="info render text edit combine extract split check tools"
APP_ARGS=
AUTOSTART=no
# The display is software-rendered (Mesa llvmpipe); one thread keeps an idle window cheap.
LP_NUM_THREADS=1
