# EffectCraft (compositing e motion graphics). Read by creative-run (creative-app@.service), the MCP bridge (mcp-server/server.py)
# and the session generator (deploy/gen-session-config.py): one file per app, no duplicated settings.
LABEL=EffectCraft
CATEGORY="Audio e video"
CONTROL_PORT=7987
OPEN_METHOD=app.open
CLI_ACTIONS="info commands exec run props get set render-frame render"
APP_ARGS=
AUTOSTART=no
# The display is software-rendered (Mesa llvmpipe); one thread keeps an idle window cheap.
LP_NUM_THREADS=1
