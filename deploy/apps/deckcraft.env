# DeckCraft (presentazioni). Read by creative-run (creative-app@.service), the MCP bridge (mcp-server/server.py)
# and the session generator (deploy/gen-session-config.py): one file per app, no duplicated settings.
LABEL=DeckCraft
CATEGORY="Documenti"
CONTROL_PORT=7979
OPEN_METHOD=app.open
CLI_ACTIONS="info render convert commands describe links run"
APP_ARGS=
AUTOSTART=yes
# The display is software-rendered (Mesa llvmpipe); one thread keeps an idle window cheap.
LP_NUM_THREADS=1
