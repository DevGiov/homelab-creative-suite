[Unit]
Description=Relay Sunshine virtual input devices into Xorg (XTest)
After=xorg-dummy.service
Requires=xorg-dummy.service

[Service]
Type=simple
User=root
Environment=DISPLAY=:0
ExecStartPre=/bin/sh -c 'while ! xdpyinfo -display :0 >/dev/null 2>&1; do sleep 0.5; done'
ExecStart=/usr/bin/python3 /opt/creative-suite/repo/input-relay/relay.py
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
