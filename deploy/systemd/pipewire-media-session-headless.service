[Unit]
Description=PipeWire Media Session Manager (Headless)
After=pipewire-headless.service
Requires=pipewire-headless.service

[Service]
Type=simple
User=root
Environment=XDG_RUNTIME_DIR=/run/user/0
ExecStart=/usr/bin/pipewire-media-session
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
