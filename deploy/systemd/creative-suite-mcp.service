[Unit]
Description=Creative Suite MCP Bridge Server
After=network.target openbox-session.service
Wants=openbox-session.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/creative-suite/repo/mcp-server
Environment=DISPLAY=:0
Environment=CREATIVE_APPS_DIR=/opt/creative-suite/repo/deploy/apps
ExecStart=/opt/creative-suite/mcp-server/.venv/bin/python3 /opt/creative-suite/repo/mcp-server/server.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
