[Unit]
Description=Creative Suite app %i (virtual display :0)
After=openbox-session.service dbus-session.service
Requires=openbox-session.service
Wants=dbus-session.service
PartOf=openbox-session.service

[Service]
Type=simple
User=root
Environment=DISPLAY=:0
Environment=XDG_RUNTIME_DIR=/run/user/0
Environment=PULSE_SERVER=unix:/run/user/0/pulse/native
# rfd (Open/Save/Import dialogs) talks to the XDG file-chooser portal over this bus.
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/0/bus
# deploy/apps/<app>.env: control port/files, extra arguments, LP_NUM_THREADS. creative-run turns
# them into the app's command line.
EnvironmentFile=/opt/creative-suite/repo/deploy/apps/%i.env
# Token and control files published by PhotoCraft / PdfCraft live here, readable by root only.
RuntimeDirectory=creative-suite
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
WorkingDirectory=/workspace
ExecStart=/usr/local/bin/creative-run %i
Restart=on-failure
RestartSec=3

[Install]
WantedBy=openbox-session.service
