[Unit]
Description=Creative Suite MCP Bridge Server
After=network.target sunshine.service openbox-session.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/creative-suite/mcp-server
Environment=PORT=7900
Environment=HOST=0.0.0.0
Environment=DISPLAY=:0
ExecStart=/opt/creative-suite/mcp-server/.venv/bin/python3 /opt/creative-suite/mcp-server/server.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
